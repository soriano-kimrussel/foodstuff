# ---------------------------------------------------------------------------
# Frontend environment. Copy to .env.local and adjust. Never commit .env.local.
# ---------------------------------------------------------------------------

# Base URL of the Express API, used by React Server Components running inside
# the Next.js container. Not exposed to the browser.
BACKEND_URL="http://localhost:4000"

# Same API, but as the browser reaches it. Only the two client components
# (subscribe button, language selector) use this. It is public by definition,
# so it must never hold a secret.
NEXT_PUBLIC_BACKEND_URL="http://localhost:4000"
