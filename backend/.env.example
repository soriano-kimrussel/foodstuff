# ---------------------------------------------------------------------------
# Backend environment. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# MySQL connection string used by Prisma.
DATABASE_URL="mysql://foodfacts:foodfacts@127.0.0.1:3307/foodfacts"

# Port the Express server listens on.
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API (the Next.js app).
CORS_ORIGINS="http://localhost:3000"

# Public URL of the frontend. Stripe Checkout returns the user here.
FRONTEND_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Demo user. Created by `npm run seed`; every request is attributed to it
# because the assignment scopes this to a single user with no auth.
# ---------------------------------------------------------------------------
DEMO_USER_EMAIL="demo@example.com"
DEMO_USER_NAME="Demo User"

# ---------------------------------------------------------------------------
# Stripe (test mode only). Get these from https://dashboard.stripe.com/test
# ---------------------------------------------------------------------------
# Secret key, starts with sk_test_
STRIPE_SECRET_KEY="sk_test_replace_me"
# Price id of a recurring monthly price, starts with price_
STRIPE_PRICE_ID="price_replace_me"
# Signing secret for the webhook endpoint, starts with whsec_
# From `stripe listen --forward-to localhost:4000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# ---------------------------------------------------------------------------
# Open Food Facts. The API is free and unauthenticated, but their terms ask
# every client to identify itself with a descriptive User-Agent.
# ---------------------------------------------------------------------------
# Product API (barcode lookups).
OFF_BASE_URL="https://world.openfoodfacts.org"
# Full-text search runs on a separate Elasticsearch-backed service. The legacy
# /cgi/search.pl endpoint on OFF_BASE_URL now returns 503 and is not used.
OFF_SEARCH_BASE_URL="https://search.openfoodfacts.org"
OFF_USER_AGENT="FoodFactsExplorer/1.0 (technical-test; demo@example.com)"
# Open Food Facts detail lookups routinely take several seconds; 8s was too
# tight in practice and produced spurious 503s.
OFF_TIMEOUT_MS=15000
# Seconds to keep an Open Food Facts response in the in-process cache.
OFF_CACHE_TTL_SECONDS=300
