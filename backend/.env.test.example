# Environment for the integration tests. Copy to .env.test.
#
# Point DATABASE_URL at a SCRATCH database. The integration suite truncates
# every table between tests, so aiming it at your development database will
# delete your data.
NODE_ENV=test
DATABASE_URL="mysql://foodfacts:foodfacts@127.0.0.1:3307/foodfacts_test"

# Fake credentials. No test reaches the Stripe network: webhook signatures are
# generated locally with this secret, and the checkout tests stub the SDK.
STRIPE_SECRET_KEY="sk_test_dummy"
STRIPE_PRICE_ID="price_dummy"
STRIPE_WEBHOOK_SECRET="whsec_test_secret"

DEMO_USER_EMAIL="demo@example.com"
DEMO_USER_NAME="Demo User"
FRONTEND_URL="http://localhost:3000"
OFF_BASE_URL="https://world.openfoodfacts.org"
OFF_SEARCH_BASE_URL="https://search.openfoodfacts.org"
# Caching off, so one test's fetch stub cannot satisfy the next test's request.
OFF_CACHE_TTL_SECONDS=0
